# BotFather token; keep private
BOT_TOKEN=PASTE_NEW_BOT_TOKEN_HERE

# Comma-separated Telegram numeric admin IDs
ADMIN_IDS=123456789

# Telegram upload/download file cap in MB
MAX_DOWNLOAD_MB=50000

# Public Telegram channel; bot must be channel administrator
REQUIRED_CHANNEL=@CyberSecurity_full_course

# Optional SQLite path
SAVERBOT_DB=saverbot.sqlite3
